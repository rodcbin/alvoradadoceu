# Copie este arquivo para .env caso ainda não exista: Copy-Item .env.example .env

# Cloudflare Workers AI (motor principal) — chaves em dash.cloudflare.com > Workers & Pages > Workers AI
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Modelo de texto da Cloudflare (opcional; padrão: llama 3.1 8B, aceito em quase toda conta)
CF_TEXT_MODEL=@cf/meta/llama-3.1-8b-instruct

# Porta do servidor local
PORT=8001

# Obs.: com Cloudflare configurada, as frases são geradas por ela; sem ela,
# cai automaticamente para o banco local (offline).
# Copie este arquivo para .env caso ainda não exista: Copy-Item .env.example .env

# Cloudflare Workers AI (motor principal) — chaves em dash.cloudflare.com > Workers & Pages > Workers AI
CF_ACCOUNT_ID=
CF_API_TOKEN=

# Modelo de texto da Cloudflare (opcional; padrão: llama 3.3 70B fp8 fast)
CF_TEXT_MODEL=@cf/meta/llama-3.3-70b-instruct-fp8-fast

# OpenRouter (backup grátis ~50 req/dia, 20 req/min; +1.000/dia com top-up de $10)
# Chave em openrouter.ai > Keys. Modelos gratuitos terminam em ":free".
OPENROUTER_API_KEY=
OPENROUTER_MODEL=nvidia/nemotron-3-ultra-550b-a55b:free

# Mistral AI (backup grátis ~1B tokens/mês, sem cartão; verificação por telefone)
# Chave em console.mistral.ai > API Keys.
MISTRAL_API_KEY=
MISTRAL_MODEL=mistral-small-latest

# Porta do servidor local
PORT=8001

# Obs.: com Cloudflare configurada, as frases são geradas por ela; se ela falhar,
# tenta OpenRouter e Mistral; em último caso, usa o banco local (offline).

# Copie este arquivo para .env e preencha (ex.: Copy-Item .env.example .env)

# Cloudflare Workers AI (motor padrão) — contas em dash.cloudflare.com
CF_ACCOUNT_ID=
CF_API_TOKEN=

# free.ai — chave gratuita em free.ai (opcional; sem ela usa Pollinations)
FREE_AI_TOKEN=

# g4f — servidor local "g4f api" (opcional; sem ele usa Pollinations)
G4F_URL=http://localhost:8080/v1/images/generations

# MiniMax / Hailuo — vídeo e voz premium (opcional). Chave com créditos em platform.minimax.io
# Sem essas chaves, o estúdio de reels usa a animação gratuita (Ken Burns) e as vozes PT-BR gratuitas.
MINIMAX_API_KEY=
MINIMAX_GROUP_ID=

# Porta do servidor (padrão 8001)
PORT=8001

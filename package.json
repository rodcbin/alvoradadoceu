{
  "name": "alvorada-do-ceu-frases",
  "version": "2.0.0",
  "private": true,
  "description": "Gerador de frases espirituais para Reels: frase, legenda e palavra-chave (Cloudflare Workers AI + banco local).",
  "main": "server.js",
  "scripts": {
    "start": "node server.js",
    "dev": "node server.js",
    "pages:dev": "wrangler pages dev public --compatibility-flags nodejs_compat",
    "pages:deploy": "wrangler pages deploy public"
  },
  "devDependencies": {
    "wrangler": "^4.0.0"
  },
  "engines": {
    "node": ">=18"
  },
  "license": "MIT"
}
